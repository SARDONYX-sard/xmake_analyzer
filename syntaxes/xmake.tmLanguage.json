{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "xmake",
  "scopeName": "source.xmake",
  "comment": "Lua 5.1-5.5 with the xmake description functions. The language server refines it with semantic tokens.",
  "patterns": [
    {
      "include": "#shebang"
    },
    {
      "include": "#code"
    }
  ],
  "repository": {
    "shebang": {
      "match": "\\A#!.*$",
      "name": "comment.line.shebang.xmake"
    },
    "code": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#function-definition"
        },
        {
          "include": "#label"
        },
        {
          "include": "#attribute"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#constants"
        },
        {
          "include": "#scopes"
        },
        {
          "include": "#xmake-apis"
        },
        {
          "include": "#modules"
        },
        {
          "include": "#builtin-functions"
        },
        {
          "include": "#method-call"
        },
        {
          "include": "#function-call"
        },
        {
          "include": "#field"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "begin": "--\\[(=*)\\[",
          "end": "\\]\\1\\]",
          "name": "comment.block.xmake",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.xmake"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.xmake"
            }
          }
        },
        {
          "begin": "---",
          "end": "$",
          "name": "comment.line.documentation.xmake",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.xmake"
            }
          },
          "patterns": [
            {
              "comment": "`@param name? type`, `@field name? type`: the name, then the type.",
              "match": "(@(?:param|field))\\s+(?:(public|protected|private|package)\\s+)?([A-Za-z_][\\w.]*\\??|\\.\\.\\.)\\s+(\\S+)",
              "captures": {
                "1": {
                  "name": "storage.type.annotation.xmake"
                },
                "2": {
                  "name": "storage.modifier.annotation.xmake"
                },
                "3": {
                  "name": "variable.parameter.annotation.xmake"
                },
                "4": {
                  "name": "entity.name.type.annotation.xmake"
                }
              }
            },
            {
              "comment": "`@return type`, `@type type`: the types.",
              "match": "(@(?:return|type|overload|vararg))\\s+(\\S+)",
              "captures": {
                "1": {
                  "name": "storage.type.annotation.xmake"
                },
                "2": {
                  "name": "entity.name.type.annotation.xmake"
                }
              }
            },
            {
              "comment": "`@class Name: Parent`, `@alias Name type`, `@enum Name`: the declared type.",
              "match": "(@(?:class|alias|enum))\\s+([A-Za-z_][\\w.]*)(?:\\s*:\\s*([A-Za-z_][\\w.]*))?",
              "captures": {
                "1": {
                  "name": "storage.type.annotation.xmake"
                },
                "2": {
                  "name": "entity.name.type.class.annotation.xmake"
                },
                "3": {
                  "name": "entity.other.inherited-class.annotation.xmake"
                }
              }
            },
            {
              "match": "(@(?:param|return|type|class|field|alias|generic|overload|deprecated|see|async|nodiscard|cast|operator|enum|module|meta|diagnostic|private|protected|package|vararg))\\b\\s*([A-Za-z_][\\w.]*)?",
              "captures": {
                "1": {
                  "name": "storage.type.annotation.xmake"
                },
                "2": {
                  "name": "variable.parameter.annotation.xmake"
                }
              }
            },
            {
              "match": "`[^`]*`",
              "name": "markup.inline.raw.xmake"
            }
          ]
        },
        {
          "begin": "--",
          "end": "$",
          "name": "comment.line.double-dash.xmake",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.xmake"
            }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "begin": "\"",
          "end": "\"|$",
          "name": "string.quoted.double.xmake",
          "patterns": [
            {
              "include": "#escapes"
            },
            {
              "include": "#interpolation"
            }
          ]
        },
        {
          "begin": "'",
          "end": "'|$",
          "name": "string.quoted.single.xmake",
          "patterns": [
            {
              "include": "#escapes"
            },
            {
              "include": "#interpolation"
            }
          ]
        },
        {
          "begin": "\\[(=*)\\[",
          "end": "\\]\\1\\]",
          "name": "string.quoted.other.multiline.xmake",
          "patterns": [
            {
              "include": "#interpolation"
            }
          ]
        }
      ]
    },
    "escapes": {
      "match": "\\\\(?:[abfnrtvz\\\\\"'\\n]|x\\h{2}|\\d{1,3}|u\\{\\h+\\})",
      "name": "constant.character.escape.xmake"
    },
    "interpolation": {
      "comment": "$(projectdir), $(builddir), $(env NAME), ... and ${color} of cprint.",
      "match": "\\$[({][^)}]*[)}]",
      "name": "constant.other.placeholder.xmake"
    },
    "numbers": {
      "patterns": [
        {
          "match": "\\b0[xX]\\h*(?:\\.\\h*)?(?:[pP][-+]?\\d+)?(?:ULL|LL|i)?\\b",
          "name": "constant.numeric.hex.xmake"
        },
        {
          "match": "(?<![\\w.])(?:\\d+\\.?\\d*|\\.\\d+)(?:[eE][-+]?\\d+)?(?:ULL|LL|i)?\\b",
          "name": "constant.numeric.decimal.xmake"
        }
      ]
    },
    "function-definition": {
      "match": "\\b(?:(local)\\s+)?(function)\\b(?:\\s+([A-Za-z_][\\w]*(?:[.:][A-Za-z_][\\w]*)*))?\\s*(?=\\()",
      "captures": {
        "1": {
          "name": "storage.modifier.local.xmake"
        },
        "2": {
          "name": "keyword.declaration.function.xmake"
        },
        "3": {
          "name": "entity.name.function.xmake"
        }
      }
    },
    "label": {
      "match": "(::)\\s*([A-Za-z_]\\w*)\\s*(::)",
      "captures": {
        "1": {
          "name": "punctuation.section.label.xmake"
        },
        "2": {
          "name": "entity.name.label.xmake"
        },
        "3": {
          "name": "punctuation.section.label.xmake"
        }
      }
    },
    "attribute": {
      "match": "(<)\\s*(const|close)\\s*(>)",
      "captures": {
        "1": {
          "name": "punctuation.definition.attribute.xmake"
        },
        "2": {
          "name": "storage.modifier.attribute.xmake"
        },
        "3": {
          "name": "punctuation.definition.attribute.xmake"
        }
      }
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(?:if|then|elseif|else|end|for|in|while|do|repeat|until|return|break|goto)\\b",
          "name": "keyword.control.xmake"
        },
        {
          "match": "\\b(?:and|or|not)\\b",
          "name": "keyword.operator.logical.xmake"
        },
        {
          "match": "\\blocal\\b",
          "name": "storage.modifier.local.xmake"
        },
        {
          "match": "\\bglobal\\b(?=\\s+(?:function\\b|[A-Za-z_*<]))",
          "name": "storage.modifier.global.xmake"
        },
        {
          "match": "\\bfunction\\b",
          "name": "keyword.declaration.function.xmake"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "match": "\\b(?:nil|true|false)\\b",
          "name": "constant.language.xmake"
        },
        {
          "match": "\\.\\.\\.",
          "name": "constant.language.vararg.xmake"
        },
        {
          "match": "\\bself\\b",
          "name": "variable.language.self.xmake"
        },
        {
          "match": "\\b_(?:G|ENV|VERSION)\\b",
          "name": "variable.language.xmake"
        }
      ]
    },
    "scopes": {
      "comment": "target(\"name\") ... target_end(): the structure of description files.",
      "match": "\\b(target|option|rule|package|toolchain|task|namespace)(_end)?\\b(?=\\s*[({\"'])",
      "name": "entity.name.function.scope.xmake"
    },
    "xmake-apis": {
      "patterns": [
        {
          "match": "\\b(?:set|add|del|remove)_[A-Za-z_]\\w*\\b(?=\\s*[({\"'])",
          "name": "entity.name.function.description.xmake"
        },
        {
          "match": "\\b(?:on|before|after)_[A-Za-z_]\\w*\\b(?=\\s*\\()",
          "name": "entity.name.function.script.xmake"
        },
        {
          "match": "\\b(?:is_(?:plat|arch|mode|os|host|subhost|subarch|kind|config|cross)|has_(?:config|package)|get_config|includes|import|inherit)\\b(?=\\s*[({\"'])",
          "name": "entity.name.function.builtin.xmake"
        }
      ]
    },
    "modules": {
      "comment": "Builtin modules of xmake and Lua, followed by a member access.",
      "match": "\\b(os|path|io|string|table|math|hash|utf8|coroutine|debug|winos|macos|linuxos|xmake|bit|utils)\\b(?=\\s*[.:])",
      "name": "entity.name.namespace.xmake"
    },
    "builtin-functions": {
      "match": "\\b(?:print|printf|cprint|cprintf|vprint|vprintf|dprint|wprint|raise|try|catch|finally|format|vformat|assert|error|pairs|ipairs|irpairs|next|select|type|tostring|tonumber|unpack|rawget|rawset|rawequal|rawlen|setmetatable|getmetatable|require|load|loadfile|dofile|pcall|xpcall|collectgarbage|val|todisplay|find_package|find_packages)\\b(?=\\s*[({\"'])",
      "name": "entity.name.function.builtin.xmake"
    },
    "method-call": {
      "match": "(:)\\s*([A-Za-z_]\\w*)\\s*(?=[({\"'])",
      "captures": {
        "1": {
          "name": "punctuation.accessor.method.xmake"
        },
        "2": {
          "name": "entity.name.function.method.xmake"
        }
      }
    },
    "function-call": {
      "match": "\\b([A-Za-z_]\\w*)\\s*(?=[({\"']|\\[=*\\[)",
      "captures": {
        "1": {
          "name": "entity.name.function.call.xmake"
        }
      }
    },
    "field": {
      "match": "(\\.)\\s*([A-Za-z_]\\w*)",
      "captures": {
        "1": {
          "name": "punctuation.accessor.xmake"
        },
        "2": {
          "name": "variable.other.property.xmake"
        }
      }
    },
    "operators": {
      "patterns": [
        {
          "match": "\\.\\.",
          "name": "keyword.operator.concatenation.xmake"
        },
        {
          "match": "==|~=|<=|>=|<(?!<)|>(?!>)",
          "name": "keyword.operator.comparison.xmake"
        },
        {
          "match": "<<|>>|&|\\||~",
          "name": "keyword.operator.bitwise.xmake"
        },
        {
          "match": "//|[-+*/%^#]",
          "name": "keyword.operator.arithmetic.xmake"
        },
        {
          "match": "=",
          "name": "keyword.operator.assignment.xmake"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "match": "[,;]",
          "name": "punctuation.separator.xmake"
        },
        {
          "match": "[()]",
          "name": "punctuation.section.parens.xmake"
        },
        {
          "match": "[{}]",
          "name": "punctuation.section.braces.xmake"
        },
        {
          "match": "[\\[\\]]",
          "name": "punctuation.section.brackets.xmake"
        }
      ]
    }
  }
}
